  "slop": {
    "note": "UI guide v2 section 11 (V1-V8): mechanical proxies on the GAID primary path. Reviewers still judge eyebrows, card grids and placeholders on screen.",
    "roots": [
      "web/src/geo",
      "web/src/app/page.tsx",
      "web/src/components/project-view.tsx",
      "web/src/components/workflows-panel.tsx"
