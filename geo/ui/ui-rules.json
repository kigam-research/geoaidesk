      "WandSparkles",
      "Wand",
      "Wand2",
      "Bot",
      "BotMessageSquare",
      "BrainCircuit",
      "Stars"
    ],
    "patterns": [
      {
        "id": "hue-utility",
        "rule": "V1",
        "regex": "\\b(?:[a-z]+:)*(?:text|bg|border|ring|fill|stroke|from|via|to|outline|decoration|divide|shadow|accent|caret)-(?:red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|slate|gray|zinc|neutral|stone)-\\d{2,3}\\b"
      },
      {
        "id": "gradient",
        "rule": "V3",
        "regex": "\\bbg-(?:gradient|linear|radial|conic)-[a-z]|(?:linear|radial|conic)-gradient\\("
      },
      {
        "id": "glass",
        "rule": "V3",
        "regex": "\\bbackdrop-(?:blur|saturate)\\b|backdrop-filter"
      },
      {
        "id": "image-filter",
        "rule": "V6",
        "regex": "\\b(?:[a-z]+:)*(?:invert|grayscale|sepia|saturate-\\d+|hue-rotate-\\d+|mix-blend-[a-z-]+)\\b"
      },
      {
        "id": "side-stripe",
        "rule": "V7",
        "regex": "\\bborder-[lr]-(?:2|4|8|\\[(?:[2-9]|\\d{2,})px\\])(?![\\w-])"
      }
    ],
    "emojiInCopy": true,
    "fontFace": {
      "css": "web/src/app/globals.css",
      "family": "Pretendard Variable"
    }
  },
  "quality": {
    "note": "UI quality kit (gaid-ui-quality-kit), run by geo/ui/quality/run.mjs from scripts/check. Each tool has a mode: 'report' prints findings and never fails the check; 'block' fails on findings that are not accepted debt in geo/ui/ui-baseline.json under quality.<tool>. Findings carry the UI guide v2 rule ids below.",
    "switchRule": "A tool moves from report to block (one-line change of modes.<tool>) when (1) every current finding on main is fixed or recorded as accepted debt with its reason in geo/ui/ui-baseline.json quality.<tool>, (2) two consecutive scripts/check runs, on PC74 and on one other PC, give the same findings and, for visual, no screenshot differences beyond the threshold, and (3) the switch is recorded in a task report. A tool that cannot run (missing browser, no network) stays report-only on that run and says so.",
    "modes": {
      "shadcnLint": "report",
      "impeccable": "report",
      "visual": "report",
      "axe": "report"
    },
