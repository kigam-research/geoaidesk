{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kigam-research.github.io/skill-atlas/schemas/geo-workflow.schema.json",
  "title": "GeoAIDesk workflow definition (registry/byok/workflows/<id>.yaml): a task template, not an executable DAG",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "description",
    "disciplines",
    "inputRoles",
    "requiredScientificChoices",
    "prompt",
    "skillIds",
    "environmentProfile",
    "expectedArtifacts",
    "boundary",
    "exampleCaseIds"
  ],
  "properties": {
    "schemaVersion": { "const": "geo-workflow/v1" },
    "id": { "$ref": "atlas-profile.schema.json#/$defs/slug" },
    "title": { "$ref": "#/$defs/bilingual" },
    "description": { "$ref": "#/$defs/bilingual" },
    "disciplines": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "atlas-profile.schema.json#/$defs/slug" }
    },
    "inputRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "formats", "required"],
        "properties": {
          "id": { "$ref": "atlas-profile.schema.json#/$defs/localId" },
          "label": { "$ref": "#/$defs/bilingual" },
          "formats": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "atlas-profile.schema.json#/$defs/slug" }
          },
          "required": { "type": "boolean" },
          "requiredWhen": { "$ref": "#/$defs/bilingual" }
        }
      }
    },
    "requiredScientificChoices": {
      "description": "Choices the researcher must make before results are valid; their ids are the keys of a geo-start recipe's choices/unresolvedChoices.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "why"],
        "properties": {
          "id": { "$ref": "atlas-profile.schema.json#/$defs/localId" },
          "label": { "$ref": "#/$defs/bilingual" },
          "why": { "$ref": "#/$defs/bilingual" },
          "options": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "$ref": "atlas-profile.schema.json#/$defs/localId" }
          },
          "requiredWhen": { "$ref": "#/$defs/bilingual" }
        }
      }
    },
    "prompt": {
      "description": "Natural-language task prompt; skill and environment binding stay in skillIds/environmentProfile, never in this text.",
      "$ref": "#/$defs/bilingual"
    },
    "skillIds": {
      "description": "Catalogue ids; the first is the primary skill. All must be in the catalogue release that ships this workflow.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "atlas-profile.schema.json#/$defs/atlasId" }
    },
    "environmentProfile": {
      "description": "An environment id from registry/byok/environments.yaml.",
      "$ref": "atlas-profile.schema.json#/$defs/slug"
    },
    "expectedArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "skill", "output", "required"],
        "properties": {
          "id": { "$ref": "atlas-profile.schema.json#/$defs/localId" },
          "label": { "$ref": "#/$defs/bilingual" },
          "skill": { "$ref": "atlas-profile.schema.json#/$defs/atlasId" },
          "output": {
            "description": "Output port id in that skill's Atlas profile (outputs[].id).",
            "$ref": "atlas-profile.schema.json#/$defs/localId"
          },
          "files": {
            "description": "File names the skill's helper writes for this artifact, when it has a helper.",
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "required": { "type": "boolean" },
          "requiredWhen": { "$ref": "#/$defs/bilingual" }
        }
      }
    },
    "boundary": {
      "description": "What the result does not claim (shown with the workflow).",
      "$ref": "#/$defs/bilingual"
    },
    "exampleCaseIds": {
      "description": "Atlas case ids of the listed skills; their files ship in the examples archive.",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "atlas-profile.schema.json#/$defs/localId" }
    },
    "compatibilityRef": {
      "description": "Install-kind evidence id showing the workflow ran in an app version; absent until such a record exists.",
      "$ref": "atlas-profile.schema.json#/$defs/localId"
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ko", "en"],
      "properties": {
        "ko": { "type": "string", "minLength": 1 },
        "en": { "type": "string", "minLength": 1 }
      }
    }
  }
}
